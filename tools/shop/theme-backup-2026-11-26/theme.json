{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "1180px", "wideSize": "1340px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#0A0A0A" },
        { "slug": "panel", "name": "Panel", "color": "#141414" },
        { "slug": "line", "name": "Linie", "color": "#262626" },
        { "slug": "muted", "name": "Grau", "color": "#8C8C8C" },
        { "slug": "paper", "name": "Weiß", "color": "#FFFFFF" },
        { "slug": "signal", "name": "Signalrot", "color": "#FF3B30" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "display", "name": "Barlow Condensed",
          "fontFamily": "\"Barlow Condensed\", Impact, sans-serif",
          "fontFace": [
            { "fontFamily": "Barlow Condensed", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-condensed-latin-600-normal.woff2"] },
            { "fontFamily": "Barlow Condensed", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-condensed-latin-700-normal.woff2"] },
            { "fontFamily": "Barlow Condensed", "fontWeight": "800", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-condensed-latin-800-normal.woff2"] }
          ]
        },
        {
          "slug": "body", "name": "Manrope",
          "fontFamily": "Manrope, Arial, sans-serif",
          "fontFace": [
            { "fontFamily": "Manrope", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/manrope-latin-400-normal.woff2"] },
            { "fontFamily": "Manrope", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/manrope-latin-500-normal.woff2"] },
            { "fontFamily": "Manrope", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/manrope-latin-700-normal.woff2"] }
          ]
        },
        {
          "slug": "mono", "name": "IBM Plex Mono",
          "fontFamily": "\"IBM Plex Mono\", monospace",
          "fontFace": [
            { "fontFamily": "IBM Plex Mono", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/ibm-plex-mono-latin-400-normal.woff2"] },
            { "fontFamily": "IBM Plex Mono", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/ibm-plex-mono-latin-500-normal.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "label", "name": "Label", "size": "11px", "fluid": false },
        { "slug": "small", "name": "Klein", "size": "14px", "fluid": false },
        { "slug": "medium", "name": "Mittel", "size": "17px", "fluid": false },
        { "slug": "large", "name": "Groß", "size": "clamp(22px, 2.2vw, 30px)", "fluid": false },
        { "slug": "xl", "name": "XL", "size": "clamp(48px, 6vw, 88px)", "fluid": false },
        { "slug": "hero", "name": "Hero", "size": "clamp(72px, 11vw, 156px)", "fluid": false }
      ]
    },
    "spacing": { "padding": true, "units": ["px", "rem", "vw", "%"] }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--paper)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.55" },
    "spacing": { "padding": { "left": "clamp(20px, 6vw, 84px)", "right": "clamp(20px, 6vw, 84px)" }, "blockGap": "1.25rem" },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--paper)" }, ":hover": { "color": { "text": "var(--wp--preset--color--signal)" } } },
      "heading": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "800", "textTransform": "uppercase", "lineHeight": "0.92", "letterSpacing": "-0.01em" },
        "color": { "text": "var(--wp--preset--color--paper)" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
        "border": { "radius": "0" },
        "typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "12px", "fontWeight": "500", "textTransform": "uppercase", "letterSpacing": "0.08em" },
        "spacing": { "padding": { "top": "16px", "bottom": "16px", "left": "26px", "right": "26px" } },
        ":hover": { "color": { "background": "var(--wp--preset--color--signal)", "text": "var(--wp--preset--color--paper)" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-wide", "title": "Seite ohne Titel (breit)", "postTypes": ["page"] }
  ]
}
